# Data — never committed. Regenerable from data/raw/ + src/ + configs/.
data/raw/*
!data/raw/PROVENANCE.md
data/processed/*
!data/processed/.gitkeep

# Unpacked-but-untransformed content (CLAUDE.md 7.10). Regenerable from data/raw/.
data/interim/*
!data/interim/.gitkeep
*.h5ad
*.h5
*.loom
*.mtx
*.mtx.gz

# Large intermediates
results/figures/*.png
results/figures/*.pdf
!results/figures/.gitkeep

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS / editor
.DS_Store
.vscode/
.idea/

# Run logs
logs/

# Shared copies, not source of truth
handoff/
